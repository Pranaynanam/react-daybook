# 1. Copy this file and rename the copy to ".env"  (same folder, no ".example")
# 2. Replace the two values below with your own.
#    Find both in Supabase → Project Settings → API.
#      VITE_SUPABASE_URL      = "Project URL"
#      VITE_SUPABASE_ANON_KEY = the "anon public" key (NOT the service_role key)
# The ".env" file is never uploaded to GitHub (see .gitignore).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-public-key-here
